<style>
#section-{{ section.id }} .intro-edito-wrapper {
  min-height: 115vh;
  height: 115vh;
  margin:0;
  position: relative;
  overflow: hidden;
  background-color: white;
}
#section-{{ section.id }} .image-marquee {
  z-index: 0;
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}
#section-{{ section.id }} .marquee-track-wrapper {
  display: flex;
  width: fit-content;
  /* animation: scrollLeft 400s linear infinite; */
}
#section-{{ section.id }} .intro-edito-text h3{
  display: flex;
  align-content: center;
  justify-content: center;
  height: 115vh;
  align-items: center;
  flex-direction: column;
}
#section-{{ section.id }} .marquee-track {
  display: grid;
  grid-template-columns: repeat(24, 1fr);
  grid-template-rows: repeat(16, 1fr);
  width: 110vw;
  height: 115vh;
  position: relative;
}

#section-{{ section.id }} .image-wrapper-edito {
  position: relative;
}

#section-{{ section.id }} .image-wrapper-edito:nth-child(1) {    
    grid-column: 1 / span 4;
    grid-row: 3 / span 6;
    transform: translateX(3%) translateY(-14%);
}

#section-{{ section.id }} .image-wrapper-edito:nth-child(2) {
    grid-column: 6 / span 2;
    grid-row: 1 / span 3;
    transform: translateY(20%);
}

#section-{{ section.id }} .image-wrapper-edito:nth-child(3) {
    grid-column: 15 / span 4;
    grid-row: 1 / span 6;
}

#section-{{ section.id }} .image-wrapper-edito:nth-child(4) {
    grid-column: 5 / span 3;
    grid-row: 10 / span 5;
    display: flex;
    flex-direction: column;
    justify-content: center;
}

#section-{{ section.id }} .image-wrapper-edito:nth-child(5) {  
    grid-column: 12 / span 4;
    grid-row: 11 / span 6;
    display: flex;
    flex-direction: column;
    justify-content: end;
}

#section-{{ section.id }} .image-wrapper-edito:nth-child(6) {
    grid-column: 18 / span 5;
    grid-row: 7 / span 8;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    z-index: 1;
    transform: translateY(-11%);
}
@keyframes scrollLeft {
  0% {
    transform: translateX(0%);
  }
  100% {
    transform: translateX(-50%);
  }
}

#section-{{ section.id }} .caption {    
  font-size: 14px;
  line-height: 1.2;
  color: #1a1a1a;
  text-transform: uppercase;
  font-family: 'Neutraface Text Demi';
  text-align: left;
  font-variant: all-small-caps;
  margin-top: 8px;
  letter-spacing: 1.5px;
}
#section-{{ section.id }} .intro-edito-text {
  display: flex;
  width: 100%;
  max-width: 500px;
    height: 100%;
    justify-content: center;
    align-items: center;
}
@media (max-width: 768px) {
  #section-{{ section.id }} .intro-edito-wrapper {
    min-height: 100vh;
    height: 100vh;
  }
    
  #section-{{ section.id }} .intro-edito-text {
    height: 100vh;
    font-size: 18px;
    line-height: 1;
  }

  #section-{{ section.id }} .marquee-track {
    height: 100vh;
  }

  #section-{{ section.id }} .marquee-track {
    width: 200vw;
  }
  #section-{{ section.id }} .intro-edito-text {
    padding: 0 32px;
  }

  {% comment %} #section-{{ section.id }} .marquee-track-wrapper {
    animation: scrollLeft 120s linear infinite;
  } {% endcomment %}

  #section-{{ section.id }} .image-wrapper-edito:nth-child(1) {    
        grid-column: 1 / span 4;
        grid-row: 2 / span 3;
  }

  #section-{{ section.id }} .image-wrapper-edito:nth-child(2) {       
    grid-column: 8 / span 4;
        transform: translateY(10%);
  }

  #section-{{ section.id }} .image-wrapper-edito:nth-child(3) {
        grid-column: 15 / span 7;
        grid-row: 1 / span 5;
  }

  #section-{{ section.id }} .image-wrapper-edito:nth-child(4) {
        grid-column: 2 / span 5;
        grid-row: 11 / span 4;
  }

  #section-{{ section.id }} .image-wrapper-edito:nth-child(5) {  
        grid-column: 8 / span 5;
        grid-row: 12 / span 5;
  }

  #section-{{ section.id }} .image-wrapper-edito:nth-child(6) {
        grid-column: 18 / span 7;
        grid-row: 11 / span 6;
  }
}

</style>

<div id="section-{{ section.id }}">
  <div class="intro-edito-wrapper relative">
    <div class="image-marquee absolute inset-0 pointer-events-none">
      <div class="marquee-track-wrapper flex w-max">
        <div class="marquee-track flex space-x-6">
          {% for block in section.blocks %}
            {% if block.settings.image %}
              <div class="image-wrapper-edito">
                <img src="{{ block.settings.image | img_url: '500x' }}" alt="Édito image"  class="w-full h-full object-cover mr-auto"/>
                {% if block.settings.caption != blank %}
                  <p class="caption">{{ block.settings.caption }}</p>
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        </div>

        <div class="marquee-track flex space-x-6">
          {% for block in section.blocks %}
            {% if block.settings.image %}
              <div class="image-wrapper-edito">
                <img src="{{ block.settings.image | img_url: '500x' }}" alt="Édito image" class="w-full h-full object-cover mr-auto"/>
                {% if block.settings.caption != blank %}
                  <p class="caption">{{ block.settings.caption }}</p>
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>

    <div class="intro-edito-text relative z-10 text-center px-4 max-w-xl mx-auto py-32">
      <a class="cta cta--underline" href="{{ section.settings.link_url }}">{{ section.settings.link_text }}</a>
    </div>
  </div>
</div>


{% schema %}
{
  "name": "Intro Édito",
  "tag": "section",
  "class": "intro-edito",
  "settings": [
    {
      "type": "text",
      "id": "link_text",
      "label": "Texte"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Url"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Légende de l'image"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Intro Édito",
      "category": "Custom"
    }
  ]
}
{% endschema %}
