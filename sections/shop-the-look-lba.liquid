{% schema %}
{
  "name": "Hotspot Produits",
  "settings": [
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Image Desktop"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Image Mobile"
    }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Hotspot",
      "settings": [
        {
          "type": "product",
          "id": "product_id",
          "label": "Produit"
        },
        {
          "type": "range",
          "id": "top_desktop",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Top Desktop",
            "default": 25
        },
        {
          "type": "range",
          "id": "left_desktop",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Left Desktop",
            "default": 25
        },
        {
          "type": "range",
          "id": "top_mobile",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Top Mobile",
            "default": 25
        },
        {
          "type": "range",
          "id": "left_mobile",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Left Mobile",
            "default": 25
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hotspot Produits",
      "category": "Produits"
    }
  ]
}
{% endschema %}

<div class="hotspot-wrapper">
  <div class="hotspot-image desktop">
    {% if section.settings.desktop_image %}
      <image-parallax class="contents">
        <img src="{{ section.settings.desktop_image | image_url: width: 1600 }}" alt="Hotspot Desktop" loading="lazy">
      </image-parallax>
    {% endif %}
    {% for block in section.blocks %}
      <div class="hotspot-point" style="top: {{ block.settings.top_desktop }}%; left: {{ block.settings.left_desktop }}%;" data-index="{{ forloop.index0 }}"></div>
    {% endfor %}
  </div>

  <div class="hotspot-image mobile">
    {% if section.settings.mobile_image %}
      <image-parallax class="contents">
        <img src="{{ section.settings.mobile_image | image_url: width: 800 }}" alt="Hotspot Mobile" loading="lazy">
      </image-parallax>
    {% endif %}
    {% for block in section.blocks %}
      <div class="hotspot-point" style="top: {{ block.settings.top_mobile }}%; left: {{ block.settings.left_mobile }}%;" data-index="{{ forloop.index0 }}"></div>
    {% endfor %}
  </div>

  {% for block in section.blocks %}
    <div class="hotspot-card" data-index="{{ forloop.index0 }}">
      {%- render 'product-card', product: block.settings.product_id, quick_buy_context: 'hotspot' -%}
    </div>
  {% endfor %}
</div>


<style>
.hotspot-wrapper {
    overflow: hidden;
  position: relative;
}

.hotspot-image {
  position: relative;
}
.hotspot-image img {
  width: 100%;
  display: block;
}
.hotspot-point {
  position: absolute;
  width: 12px;
  height: 12px;
  background: white;
  border: none;
  border-radius: 50%;
  cursor: pointer;
  z-index: 2;
  transform: translate(-50%, -50%);
  transition: transform 0.3s ease;
  animation: pulse 1.6s ease-out infinite;
}
.hotspot-point:hover {
  transform: translate(-50%, -50%) scale(1.3);
}
.hotspot-card {
  position: absolute;
  z-index: 3;
  max-width: 320px;
  background: white;
  padding: 0;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
  transform: translate(0, 0);
}
.hotspot-card.active {
  opacity: 1;
  pointer-events: all;
}
.hotspot-image.mobile {
  display: none;
}
@keyframes pulse {
  0% {
    box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.30);
  }
  60% {
    box-shadow: 0 0 0 12px rgba(255, 255, 255, 0.30);
  }
  100% {
    box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.30);
  }
}
@media screen and (max-width: 768px) {
  .hotspot-image.desktop {
    display: none;
  }
  .hotspot-image.mobile {
    display: block;
  }
  .hotspot-point {
    width: 8px;
    height: 8px;
  }
}

</style>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const points = document.querySelectorAll('.hotspot-point');
  const cards = document.querySelectorAll('.hotspot-card');
  const wrapper = document.querySelector('.hotspot-wrapper');

  function closeAllCards() {
    cards.forEach(card => card.classList.remove('active'));
  }

  points.forEach(point => {
    point.addEventListener('click', (e) => {
      const index = point.dataset.index;
      const card = wrapper.querySelector(`.hotspot-card[data-index="${index}"]`);
      if (!card) return;

      closeAllCards();

      // Récupère position du point relatif au wrapper
      const pointRect = point.getBoundingClientRect();
      const wrapperRect = wrapper.getBoundingClientRect();

      const top = pointRect.top - wrapperRect.top;
      const left = pointRect.left - wrapperRect.left;

      // Décalage : place la carte à droite du point
    const cardOffsetX = 30; // ← plus grand pour décaler davantage à droite
    const cardOffsetY = - card.offsetHeight / 2; 

      card.style.top = `${top + cardOffsetY}px`;
      card.style.left = `${left + cardOffsetX}px`;
      card.classList.add('active');
    });
  });

  // Clique en dehors => ferme la carte
  document.addEventListener('click', function (e) {
    if (!e.target.closest('.hotspot-point') && !e.target.closest('.hotspot-card')) {
      closeAllCards();
    }
  });
});

</script>
