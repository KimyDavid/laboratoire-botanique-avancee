  ],
  "presets": [
    {
      "name": "t:sections.multi_column.presets.multi_column.name",
      "blocks": [
        {
          "type": "image_with_text",
          "settings": {}
        },
        {
          "type": "image_with_text",
          "settings": {}
        },
        {
          "type": "image_with_text",
          "settings": {}
        }
      ]
    }
  ]
}
