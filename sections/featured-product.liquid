{%- comment -%}
  Featured product: one image on one side, a colored panel on the other side with an eyebrow, a title, a description,
  an add to cart button (price on its right) and app blocks under it (ex : the Avis Vérifiés rating).
  Desktop: the image overflows the panel at the top and bottom, over the previous and next sections.
  The image is the custom one, or the first image of the product.
  The button adds the product to the cart (a single-variant product is added directly as a one-time purchase, otherwise the quick buy modal opens).
{%- endcomment -%}

{%- liquid
  assign featured_product = section.settings.product
  assign featured_image = section.settings.image | default: featured_product.featured_media.preview_image
  assign featured_title = section.settings.title | default: featured_product.title
  assign featured_variant = featured_product.selected_or_first_available_variant
  assign sold_out_label = 'product.general.sold_out_button' | t
-%}

<section
  class="featured-lba {% if section.settings.image_position == 'end' %}featured-lba--media-end{% endif %} {% render 'responsive-visibility', visibility: section.settings.visibility %}"
  style="--featured-lba-overflow: {{ section.settings.image_overflow }}px; --featured-lba-min-height: {{ section.settings.min_height }}px; --featured-lba-background: {{ section.settings.background_color }}; --featured-lba-text-color: {{ section.settings.text_color }};"
>
  <div class="featured-lba__inner">
    {%- if featured_image != blank -%}
      <div class="featured-lba__media">
        {%- capture image_alt -%}{{ featured_image.alt | default: featured_title | escape }}{%- endcapture -%}
        {{- featured_image | image_url: width: 1800 | image_tag: class: 'featured-lba__image', loading: 'lazy', sizes: '(min-width: 1000px) 50vw, 100vw', widths: '400,600,800,1000,1200,1400,1800', alt: image_alt -}}
      </div>
    {%- endif -%}

    <div class="featured-lba__panel">
      <div class="featured-lba__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="featured-lba__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}

        {%- if featured_title != blank -%}
          <h2 class="featured-lba__title h3">{{ featured_title }}</h2>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <div class="featured-lba__description prose">{{ section.settings.description }}</div>
        {%- endif -%}

        {%- if featured_product != blank and section.settings.button_label != blank -%}
          <div class="featured-lba__buy">
            {%- comment -%}Without a selling_plan field, the variant is added as a one-time purchase, even if the product offers subscriptions{%- endcomment -%}
            {%- if featured_product.variants.size == 1 and featured_variant.requires_selling_plan == false -%}
              <product-form>
                {%- form 'product', featured_product -%}
                  <input type="hidden" name="on_success" value="force_open_drawer">
                  <input type="hidden" name="quantity" value="1">
                  <input type="hidden" name="id" value="{{ featured_variant.id }}">
                  {%- if featured_variant.available -%}
                    {%- render 'button', type: 'submit', style: 'solid', content: section.settings.button_label, background: section.settings.button_background, text_color: section.settings.button_text_color -%}
                  {%- else -%}
                    {%- render 'button', type: 'submit', style: 'solid', content: sold_out_label, disabled: true, background: section.settings.button_background, text_color: section.settings.button_text_color -%}
                  {%- endif -%}
                {%- endform -%}
              </product-form>
            {%- else -%}
              {%- assign quick_buy_id = 'product-quick-buy-' | append: section.id | append: '-' | append: featured_product.id -%}

              {%- render 'button', type: 'button', style: 'solid', content: section.settings.button_label, aria_controls: quick_buy_id, background: section.settings.button_background, text_color: section.settings.button_text_color -%}

              <quick-buy-modal handle="{{ featured_product.handle }}?variant={{ featured_variant.id }}" class="quick-buy-modal modal" id="{{ quick_buy_id }}">
              </quick-buy-modal>
            {%- endif -%}

            {%- if section.settings.show_price -%}
              <span class="featured-lba__price h3">{{ featured_product.price | money }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- comment -%}
          App blocks (ex : Judge.me rating), displayed under the button.
          The Judge.me badge text ("9 avis") is replaced by the average rating ("4,9/5"), read from the Judge.me badge metafield
          (or the Shopify reviews metafield that Judge.me can also fill)
        {%- endcomment -%}
        {%- liquid
          assign featured_rating = 0
          assign judgeme_badge = featured_product.metafields.judgeme.badge | replace: '"', "'"

          if judgeme_badge contains "data-average-rating='"
            assign featured_rating = judgeme_badge | split: "data-average-rating='" | last | split: "'" | first | plus: 0
          elsif featured_product.metafields.reviews.rating.value != blank
            assign featured_rating = featured_product.metafields.reviews.rating.value.rating | plus: 0
          endif

          if featured_rating > 0
            assign featured_rating_text = featured_rating | round: 1 | append: '' | replace: '.', ',' | append: '/5'
          endif
        -%}

        {%- for block in section.blocks -%}
          {%- if block.type == '@app' -%}
            <div class="featured-lba__app {% if featured_rating > 0 %}featured-lba__app--rating-value{% endif %}" {% if featured_rating > 0 %}style="--featured-lba-rating: '{{ featured_rating_text }}';"{% endif %} {{ block.shopify_attributes }}>
              {%- render block -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.featured_product.name",
  "class": "shopify-section--featured-product",
  "disabled_on": {
    "templates": ["password"],
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Produit"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Facultatif : sinon la première image du produit est utilisée."
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Position de l'image (desktop)",
      "options": [
        { "value": "start", "label": "Gauche" },
        { "value": "end", "label": "Droite" }
      ],
      "default": "start"
    },
    {
      "type": "range",
      "id": "image_overflow",
      "label": "Débordement de l'image (desktop)",
      "info": "L'image dépasse d'autant en haut et en bas, par-dessus les sections précédente et suivante.",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Hauteur minimale du bloc coloré (desktop)",
      "min": 300,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 480
    },
    {
      "type": "header",
      "content": "Contenu"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Surtitre",
      "default": "Pour commencer"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "info": "Facultatif : sinon le titre du produit est utilisé."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texte du bouton",
      "default": "Ajouter au panier",
      "info": "Le bouton ajoute le produit au panier. Un produit à variante unique est ajouté directement en achat unique, sinon la fenêtre de choix des options s'ouvre."
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Afficher le prix à droite du bouton",
      "default": true
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Couleur de fond du bloc",
      "default": "#46626B"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Couleur du texte",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Fond du bouton",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Texte du bouton",
      "default": "#46626B"
    },
    {
      "type": "header",
      "content": "Affichage"
    },
    {
      "type": "select",
      "id": "visibility",
      "label": "t:global.visibility.label",
      "options": [
        { "value": "all", "label": "t:global.visibility.options.all" },
        { "value": "mobile", "label": "t:global.visibility.options.mobile" },
        { "value": "desktop", "label": "t:global.visibility.options.desktop" }
      ],
      "default": "all"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured_product.presets.featured_product.name"
    }
  ]
}
{% endschema %}
