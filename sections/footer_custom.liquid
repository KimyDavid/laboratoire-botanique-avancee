{% if section.settings.newsletter_enabled %}
  <div class="newsletter-section" style="background-color: {{ section.settings.background_color }};">
    <div class="newsletter-wrapper">
      {%- render 'icon' with 'lba-monogram', class: 'newsletter-logo' -%}
      <h3 class="newsletter-title">{{ section.settings.newsletter_title }}</h3>
      <div class="newsletter-description">{{ section.settings.newsletter_subtext }}</div>
      <div class="klaviyo-form-YwnhWT"></div>
      <p class="newsletter-legal p2">
        {{ section.settings.newsletter_legal_text }}
        <a href="{{ section.settings.privacy_policy_url }}" target="_blank">Politique de confidentialité</a>.
      </p>
    </div>
  </div>
{% endif %}
<footer class="footer-custom" style="background-color: {{ section.settings.background_color }};">
  <!-- Menu gauche -->
  <div class="footer-column footer-nav">
    <div>
      {% if section.settings.left_menu != blank %}
        <ul class="footer-menu-main">
          {% for link in linklists[section.settings.left_menu].links %}
            <li><a class="footer-link cta_link_lba" href="{{ link.url }}">{{ link.title }}</a></li>
          {% endfor %}
          <li class="lang_selector"><span class="cta_link_lba">{{ 'general.localization.language' | t }} :</span>
            <noscript>
              <div class="lang-switcher-noscript">
                <a href="https://laboratoires-botanique-avancee.com" hreflang="fr" lang="fr">FR</a>
                <a href="https://laboratoires-botanique-avancee.com/en" hreflang="en" lang="en">EN</a>
              </div>
            </noscript>
            {%- render 'localization-selector', type: 'locale', placement: 'top-start' -%}</li>
        </ul>
      {% endif %}
      {% if section.settings.left_menu_mobile != blank %}
        <ul class="mobile">
          {% for link in linklists[section.settings.left_menu_mobile].links %}
            {% unless forloop.first %}<li class="footer-sep" aria-hidden="true">•</li>{% endunless %}
            <li><a class="footer-link cta_link_lba" href="{{ link.url }}">{{ link.title }}</a></li>
          {% endfor %}
          {% if linklists[section.settings.left_menu_mobile].links.size > 0 %}<li class="footer-sep" aria-hidden="true">•</li>{% endif %}
          <li><a class="footer-link cta_link_lba" href="javascript:void(0)" onclick="Cookiebot.renew()">Gérer mes cookies</a></li>
        </ul>
      {% endif %}
    </div>
  </div>

  <!-- Logo ou texte au centre -->
  <div class="footer-center">
    {% if section.settings.logo_svg %}
      {{ section.settings.logo_svg }}
    {% else %}      
    {% if section.settings.logo != blank %}
      <img src="{{ section.settings.logo | image_url: width: 287 }}" alt="Logo footer">
