<script>
  // Hides the separator dots that end up at the start or at the end of a row once the legal links wrap
  (() => {
    const list = document.querySelector('.footer-custom ul.mobile');
    if (!list) return;

    const separators = list.querySelectorAll('.footer-sep');
    const centerY = (element) => {
      const rect = element.getBoundingClientRect();
      return rect.top + rect.height / 2;
    };

    const update = () => {
      separators.forEach((separator) => { separator.hidden = false; });

      if (list.offsetParent === null) return;

      separators.forEach((separator) => {
        const y = centerY(separator);
        const isOnItsRow = (sibling) => sibling && Math.abs(centerY(sibling) - y) < 4;

        if (!isOnItsRow(separator.previousElementSibling) || !isOnItsRow(separator.nextElementSibling)) {
          separator.hidden = true;
        }
      });
    };

    new ResizeObserver(update).observe(list);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(update);
    update();
  })();
</script>
  <div class="footer-bottom-image" style="text-align: center; background-color: {{ section.settings.background_color }};">
