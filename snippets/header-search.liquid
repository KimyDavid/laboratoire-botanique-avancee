{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
HEADER SEARCH
----------------------------------------------------------------------------------------------------------------------

Code of the predictive search in the header. This uses the "predictive-search" component. The resources being
searched are controlled by the Search & Discovery app.

********************************************
Supported variables
********************************************

Nothing
{%- endcomment -%}

<header-search id="header-search-{{ section.id }}" class="header-search">
  <div class="container">
    <form id="predictive-search-form" action="{{ routes.search_url }}" method="GET" aria-owns="header-predictive-search" class="header-search__form" role="search">
      <div class="header-search__form-control">
        {%- render 'icon' with 'search', width: 20 -%}
        <input type="search" name="q"  maxlength="60" spellcheck="false" class="header-search__input h5 sm:h4" aria-label="{{ 'header.general.search_mobile' | t | escape }}" placeholder="{{ 'header.general.search_mobile' | t | escape }}">

      </div>
      <dialog-close-button class="contents">
        <button type="button">
          <span class="sr-only">{{ 'general.accessibility.close' | t }}</span>
          {%- render 'icon' with 'close', width: 16 -%}
        </button>
      </dialog-close-button>
    </form>

    <predictive-search id="header-predictive-search" class="predictive-search">
      <div class="predictive-search__content" slot="results"></div>
    </predictive-search>

    <div class="header-search__default">
      {% if menu != blank and menu.links.size > 0 %}
        <div class="header-search__default-menu-wrapper">
          <span class="header-search__default-heading">{{ 'search.general.popular_terms' | t }}</span>
          <ul class="header-search__default-menu">
            {% for link in menu.links %}
              <li><a class="cta" href="{{ link.url }}">{{ link.title }}</a></li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}
      {% if products != blank %}
        <div class="header-search__default-products-wrapper">
          <span class="header-search__default-heading">{{ 'search.general.popular_products' | t }}</span>
          <div class="header-search__default-products">
            {% for product in products %}
              {%- render 'product-card', product: product, position: forloop.index, hide_product_information: false -%}
            {% endfor %}
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</header-search>