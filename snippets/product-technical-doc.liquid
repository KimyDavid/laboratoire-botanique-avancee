{%- liquid
  assign doc = product.metafields.custom.fiche_technique.value

  assign doc_classes = 'product-key-features product-technical-doc'
  if block.settings.text_color != blank and block.settings.text_color.rgba != '0 0 0 / 0.0'
    assign doc_classes = doc_classes | append: ' product-key-features--custom-text'
  endif

  assign file_name = doc.url | default: '' | split: '?' | first | split: '/' | last
  assign link_label = block.settings.link_label | default: file_name
-%}

{%- if doc != blank -%}
  <ul
    class="{{ doc_classes }}"
    {{ block.shopify_attributes }}
    style="
      {% render 'color-var' with block.settings.background_color, name: 'key-features-background-color' %}
      {% render 'color-var' with block.settings.text_color, name: 'key-features-text-color' %}
    "
  >
    <li class="product-key-features__item">
      {%- if block.settings.heading != blank -%}
        <span class="product-key-features__title">{{ block.settings.heading }}</span>
      {%- endif -%}

      <span class="product-key-features__content">
        <a
          class="product-technical-doc__link"
          href="{{ doc.url }}"
          download
          target="_blank"
          rel="noopener"
        >
          <svg
            class="product-technical-doc__icon"
            viewBox="0 0 24 24"
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 3v12" />
            <path d="m7 10 5 5 5-5" />
            <path d="M5 21h14" />
          </svg>
          <span>{{ link_label }}</span>
        </a>
      </span>
    </li>
  </ul>

  <style>
    .product-technical-doc__link {
      display: inline-flex;
      align-items: center;
      gap: 0.5em;
      color: inherit;
      text-underline-offset: 0.25em;
    }

    .product-technical-doc__link:hover {
      text-decoration: underline;
    }

    .product-technical-doc__icon {
      flex-shrink: 0;
    }
  </style>
{%- endif -%}
