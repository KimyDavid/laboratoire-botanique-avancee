image":"shopify:\/\/shop_images\/61f7f7f032b6ab88d3b799e0dbab41b93379dfc1.png","image_fullsize":false,"reveal_on_scroll":true,"image_position":"end","content_width":"xl","remove_vertical_spacing":false,"id":"efficacite"}},"image_text_lba_AirP9G":{"type":"image-text-lba","custom_css":["@media (min-width: 1000px) {.duo-section {display: none !important; }}"],"name":"Duo image + texte","settings":{"section_height":"full-height","image":"shopify:\/\/shop_images\/03_BULLE_V11_rvb_MD_ef0b5759-64c5-45c1-9134-d18f094c4320.png","background_color":"#ffffff","image_layout":"full","video_size":"full-height","image_position":"right","title":"LA TECHNOLOGIE EXCLUSIVE NEO-REGEN : UNE TRIPLE EFFICACITÉ","text":"<p>Créée en collaboration avec le<strong> Dr Lemaitre<\/strong>, l'expert français de la longévité, NEO-REGEN relance la régénération de la peau à 3 niveaux :  <strong>Régénération cellulaire, moléculaire et tissulaire.<\/strong><\/p><p>Efficacité prouvée. Action sur 136 gènes.<\/p>","button_link":"https:\/\/laboratoires-botanique-avancee.com\/pages\/expertise\/#technologie-neoregen","button_label":"Découvrir le neo-regen","id":"neo-regen"}},"slider_vertical_product_lba_6cdKzx":{"type":"slider_vertical_product_lba","blocks":{"texte_slide_MCMLDg":{"type":"texte_slide","settings":{"image":"shopify:\/\/shop_images\/043dcc447e389adc7fa2e3c32e22f7eb56c8b27b_1.png","image_overlay":"none","text_position":"start","width_content":"600px","text_color":"#ffffff","title":"NEO-REGEN TECHNOLOGIE EXCLUSIVE","description":"<p><strong>Triple efficacité <\/strong>: relance la régénération de la peau à 3 niveaux<\/p><p>-Régénération cellulaire<br\/>-Régénération moléculaire<br\/>-Régénération tissulaire<br\/><br\/>Créée en collaboration avec le Dr Lemaitre, l’expert français de la<br\/>longévité. <\/p>","button_texte":"Découvrir le neo-regen","button":"\/pages\/expertise\/#technologie-neoregen"}}},"block_order":["texte_slide_MCMLDg"],"custom_css":["@media (min-width: 1280px) {.container {--container-gutter: 4rem; }}","@media (max-width: 1000px) {.vertical-slider-wrapper {display: none !important; }}"],"name":"Slider vertical produit","settings":{"id":"neo-regen"}},"multi_column_JnxFpy":{"type":"multi-column","blocks":{"image_with_text_NM9Btg":{"type":"image_with_text","settings":{"image":"shopify:\/\/shop_images\/1950X1950_INGREDIENTS_CELLULE_IRIS.webp","title":"CELLULES SOUCHES D’IRIS BIOTECH","heading_tag":"h3","content":"<p><strong>Fermeté, élasticité, souplesse<\/strong><\/p><ul><li>Stimule la synthèse de collagène.<\/li><li>Limite la dégradation des fibres dermiques.<\/li><li>Active la production de GAGs.<\/li><\/ul>","link_url":"","link_text":""}},"image_with_text_Hi9q4B":{"type":"image_with_text","settings":{"image":"shopify:\/\/shop_images\/1950X1950_INGREDIENTS_CANTELLARIA_7264147f-d4df-47db-8392-04853b8f7e7b.webp","title":"<strong>CENTELLA ASIATIQUE + VITAMINE E BIOTECH<\/strong>","heading_tag":"h3","content":"<p><strong>Éclat, apaisant<\/strong><\/p><ul><li>Herbe du Tigre, plante médicinale.<\/li><li>Reconnu pour ses propriétés réparatrice et anti-inflammatoire. <\/li><li>Puissant antioxydant.<\/li><\/ul>","link_url":"","link_text":""}},"image_with_text_DLzJpi":{"type":"image_with_text","settings":{"image":"shopify:\/\/shop_images\/1950X1950_ECTOINE.webp","title":"<strong>ÉCTOÏNE BIOTECH<\/strong>","heading_tag":"h3","content":"<p><strong>Bouclier protecteur & antioxydation<\/strong><\/p><ul><li>Prévient les dommages des UV, lumière bleu et infra-rouge. <\/li><li>Protège la peau des polluants atmosphériques. <\/li><li>Protège la peau face aux changements de température. <\/li><\/ul>","link_url":"","link_text":""}}},"block_order":["image_with_text_NM9Btg","image_with_text_Hi9q4B","image_with_text_DLzJpi"],"name":"t:sections.multi_column.presets.multi_column.name","settings":{"color_scheme":"scheme-2","separate_section_with_border":false,"columns_per_row":3,"stack_on_mobile":false,"overlap_image":false,"content_alignment":"start","text_alignment":"start","spacing":"xs","subheading":"","title":"DES ACTIFS PUISSANTS, HAUTEMENT CONCENTRÉS","content":"","button_label":"","button_link":""}},"rich_text_NjM6pw":{"type":"rich-text","blocks":{"heading_QAUCkL":{"type":"heading","settings":{"text":"Pour la <strong>première fois au monde<\/strong>, une efficacité prouvée sur <strong>organoïde de peau<\/strong>, issu de <strong>30ans de recherche <\/strong>en médecine régénérative. ","heading_tag":"h1-light"}}},"block_order":["heading_QAUCkL"],"name":"t:sections.rich_text.presets.rich_text.name","settings":{"color_scheme":"","separate_section_with_border":false,"content_width":"md","text_position":"center","remove_vertical_spacing":false}},"image_text_lba_ELymAP":{"type":"image-text-lba","blocks":{"description_PxWdBb":{"type":"description","settings":{"image":"shopify:\/\/shop_images\/787ee7f667a8f258fcf01afa035928af7db6c96b_127be234-de9e-425c-b41a-38cfa8eaa30a.png","title_":"DR Jean-Marc Lemaitre","text":"<p>- Diplômé d'un Doctorat de Biologie Moléculaire et Cellulaire (1995).<br\/>- Première équipe au monde a avoir démontré que le vieillissement cellulaire était réversible (2011).<br\/>- Directeur de recherche INSERM.<br\/>- Co-directeur de l’Institut de Médecine Régénérative de Montpellier. <\/p>"}}},"block_order":["description_PxWdBb"],"custom_css":["section {background: #fafafa;}"],"name":"Duo image + texte","settings":{"section_height":"full-height","background_color":"#ffffff","image_layout":"full","video":"shopify:\/\/files\/videos\/LBA_CD_7s-30-ANS-RECHERCHE_1_1.mp4","video_size":"full-height","image_position":"left","title":"PREMIÈRE MONDIALE","text":"<p><strong>Pour la première fois au monde <\/strong>et en collaboration avec le<strong> Dr Lemaitre<\/strong>, l'efficacité d'actifs cosmétiques est prouvée sur un modèle révolutionnaire, issu de 30 ans de recherche en médecine régénérative : <strong>l'organoïde de peau.<\/strong><\/p>","button_link":"\/pages\/expertise\/#dr-jm-lemaitre","button_label":"En savoir plus","id":""}},"image_with_text_URTYB3":{"type":"image-with-text","blocks":{"heading_E9yaGJ":{"type":"heading","settings":{"text":"<strong>UNE PROUESSE DE FORMULATION<\/strong>","heading_tag":"h2"}},"richtext_VYaTdx":{"type":"richtext","settings":{"content":"<p>Le Sérum en Crème Régénératif renferme un <strong>haut taux d'actifs (30%) : <\/strong>une véritable prouesse de formulation. <\/p><p>Nos scientifiques appliquent<strong> une charte de formulation restrictive<\/strong> : les silicones, PEG et tout ingrédient suspecté néfaste pour la peau sont bannis.<\/p><p>Sa structure<strong> lamellaire biomimétique<\/strong>, permet une affinité exceptionnelle avec la peau. <\/p>","font_size":"base"}},"heading_9iyyKC":{"type":"heading","settings":{"text":"UNE SIGNATURE OLFACTIVE ENVELOPPANTE","heading_tag":"h2"}},"richtext_ddcf6Y":{"type":"richtext","settings":{"content":"<p>Travaillé par Céline Barel (IFF), le parfum allie la douceur des fleurs blanches, offrant une signature fraîche, enveloppante comme une caresse de peau.<\/p><p><em>(Bergamote - Baies - Jasmin sambac - Lys blanc – racine d’Iris - Vétiver)<\/em><\/p>","font_size":"base"}}},"block_order":["heading_E9yaGJ","richtext_VYaTdx","heading_9iyyKC","richtext_ddcf6Y"],"name":"t:sections.image_with_text.presets.image_with_text.name","settings":{"color_scheme":"scheme-2","separate_section_with_border":false,"image":"shopify:\/\/shop_images\/07_Beaulieu_Pipette_V4_rvb_MD_1f82c64c-d792-4b5c-89a0-d75a8d94c674.webp","image_fullsize":true,"reveal_on_scroll":true,"image_position":"end","content_width":"xl","remove_vertical_spacing":false,"id":""}},"section_lba_scroll_blur_RQEcmJ":{"type":"section-lba-scroll-blur","name":"Scroll Blur Section","settings":{"image":"shopify:\/\/shop_images\/creme.webp","product":"creme-fondante-regenerative","title":"La crème fondante régénérative","description":"","description_alt":"<p>La Crème Fondante Régénérative relance les mécanismes de régénération de la peau.<br\/><br\/> 136 gènes clés du vieillissement cutané sont réactivés pour une peau ferme, lisse, uniforme et confortable tout au long de la journée.<\/p>","cta_text":"Découvrir"}},"image_text_lba_Kx8xjm":{"type":"image-text-lba","name":"Duo image + texte","settings":{"section_height":"full-height","background_color":"#ffffff","image_layout":"full","video":"shopify:\/\/files\/videos\/recharge-serum_1_1_251212.mp4","video_size":"full-height","image_position":"left","title":"l'abonnement","text":"<p>Lors de votre commande, sélectionnez un abonnement, disponible pour la plupart de nos produits. <br\/><br\/>Choisissez la fréquence qui vous convient et modifiez-la ou déplacez vos livraisons à tout moment. <br\/><br\/>Chaque commande est expédiée automatiquement selon vos préférences, avec un e-mail avant chaque envoi pour ajuster adresse ou pause. La livraison standard est gratuite sur toutes les commandes planifiées.<\/p>","button_link":"shopify:\/\/pages\/faq","button_label":"En savoir plus","id":"laboratoire-biotechnologie"}},"17854992115c34f87a":{"type":"apps","blocks":{"judge_me_reviews_review_widget_P3GKhA":{"type":"shopify:\/\/apps\/judge-me-reviews\/blocks\/review_widget\/61ccd3b1-a9f2-4160-9fe9-4fec8413e5d8","settings":{"review_data":"sample_data","max_width":1200,"show_shop_reviews":false,"empty_state":"empty_widget"}}},"block_order":["judge_me_reviews_review_widget_P3GKhA"],"settings":{"color_scheme":"","separate_section_with_border":true,"remove_vertical_spacing":false,"remove_horizontal_spacing":false}},"featured_collections_fmd6QB":{"type":"featured-collections","blocks":{"collection_TCxwyY":{"type":"collection","settings":{"collection":"all","products_count":8,"title":"La gamme","link_url":"shopify:\/\/collections\/all","link_text":"Voir tout"}}},"block_order":["collection_TCxwyY"],"name":"t:sections.featured_collections.presets.featured_collections.name","settings":{"color_scheme":"scheme-2","separate_section_with_border":false,"hide_product_information":false,"show_product_subtit