shopify:\/\/shop_images\/03_BULLE_V11_rvb_MD_ef0b5759-64c5-45c1-9134-d18f094c4320.png","background_color":"#ffffff","image_layout":"full","video_size":"full-height","image_position":"right","title":"LA TECHNOLOGIE EXCLUSIVE NEO-REGEN : UNE TRIPLE EFFICACITÉ","text":"<p>NEO-REGEN réactive 136 gènes impliqués dans le vieillissement de la peau, relançant ainsi ses capacités régénératives. Cocréée avec le Dr Lemaitre, pionnier de la longévité cellulaire. <\/p><p>Son efficacité a été démontrée cliniquement à 3 niveaux :  Régénération tissulaire, cellulaire et moléculaire.<\/p><p>Composition : cellules souches de Lys et de Pivoine au pouvoir de régénération infini et Eau de Baulieu liposomée relipidante.<\/p>","button_link":"https:\/\/laboratoires-botanique-avancee.com\/pages\/expertise\/#technologie-neoregen","button_label":"Découvrir le neo-regen","id":"neo-regen"}},"slider_vertical_product_lba_6cdKzx":{"type":"slider_vertical_product_lba","blocks":{"texte_slide_MCMLDg":{"type":"texte_slide","settings":{"image":"shopify:\/\/shop_images\/573eeaea987436aef3fb80435acd58740023dc50_1.jpg","image_overlay":"none","text_position":"start","width_content":"600px","text_color":"#ffffff","title":"NEO-REGEN TECHNOLOGIE EXCLUSIVE","description":"<p><strong>Triple efficacité <\/strong>: relance la régénération de la peau à 3 niveaux<\/p><p>-Régénération cellulaire<br\/>-Régénération moléculaire<br\/>-Régénération tissulaire<br\/><br\/>Créée en collaboration avec le Dr Lemaitre, l’expert français de la<br\/>longévité. <\/p>","button_texte":"Découvrir le neo-regen","button":"\/pages\/expertise\/#technologie-neoregen"}}},"block_order":["texte_slide_MCMLDg"],"custom_css":["@media (min-width: 1280px) {.container {--container-gutter: 4rem; }}","@media (max-width: 1000px) {.vertical-slider-wrapper {display: none !important; }}"],"name":"Slider vertical produit","settings":{"id":"neo-regen"}},"image_text_lba_VBcQTb":{"type":"image-text-lba","name":"Duo image + texte","settings":{"section_height":"full-height","image":"shopify:\/\/shop_images\/1950X1950_KVSERUM.webp","background_color":"#ffffff","image_layout":"boxed","video_size":"full-height","image_position":"right","title":"Sérum en Crème Régénératif","text":"<p><strong>Ce soin concentre à lui seul l'efficacité d'un sérum et le confort d'une crème légère.<\/strong><\/p><p><br\/><\/p><p><strong>RÉSULTATS<\/strong> : +53% de fermeté et -21% de rides en 3 mois*, une peau hydratée en profondeur, plus souple et lumineuse. <br\/><br\/><\/p><p><strong>ACTIFS CLÉS <\/strong><\/p><ul><li>7,5 millions de cellules souches végétales: stimulent la synthèse de collagène, booste la fermeté et l'élasticité de la peau. <\/li><li>Centella Asiatica : antioxydant et anti-inflammatoire.<\/li><li>Ectoine: hydratation profonde et protection. <br\/><br\/><\/li><\/ul><p>Sa texture crème légère fusionne avec la peau, sans effet matière et parfaite sous le maquillage.<\/p><p>Une formule sans silicone, sans PEG, sans phénoxyéthanol ou tout ingrédient suspecté néfaste pour la peau.<\/p>","button_link":"shopify:\/\/products\/serum-creme-regeneratif","button_label":"Découvrir","id":""}},"image_text_lba_GgqdPP":{"type":"image-text-lba","disabled":true,"name":"Duo image + texte","settings":{"section_height":"full-height","image":"shopify:\/\/shop_images\/31_BAULIEU_KV_ET_SCIENCE_V8_rvb_copie.webp","background_color":"#ffffff","image_layout":"boxed","video_size":"full-height","image_position":"left","title":"crème fondante régénérative","text":"<p>Hautement concentrée à <strong>30% d’actifs.<\/strong><\/p><p>La peau est raffermie, les rides sont corrigées, le teint est unifié avec un confort et une douceur immédiats. La barrière cutanée est renforcée. <\/p><p><strong>+53% peau plus ferme<\/strong><\/p>","button_link":"shopify:\/\/products\/creme-fondante-regenerative","button_label":"Découvrir","id":""}},"image_text_lba_n6eKY8":{"type":"image-text-lba","name":"Duo image + texte","settings":{"section_height":"full-height","image":"shopify:\/\/shop_images\/1950X1950_KV_YEUX.webp","background_color":"#ffffff","image_layout":"boxed","video_size":"full-height","image_position":"left","title":"Crème yeux soyeuse Régénérative","text":"<p>Hautement concentrée à <strong>32% d’actifs.<\/strong><\/p><p>Le contour de l'œil est lissé. Les cernes, poches et ridules sont atténuées, le regard est reposé, éclatant. <\/p><p><br\/><strong>100% des femmes l’ayant testé la recommande et souhaitent l’acheter.<\/strong><\/p>","button_link":"shopify:\/\/products\/creme-yeux-soyeuse-regenerative","button_label":"Découvrir","id":""}},"rich_text_NjM6pw":{"type":"rich-text","blocks":{"heading_QAUCkL":{"type":"heading","settings":{"text":"Pour la <strong>première fois au monde<\/strong>, une efficacité prouvée sur <strong>organoïde de peau<\/strong>, issu de <strong>30 ans de recherche <\/strong>en médecine régénérative. ","heading_tag":"h1-light"}}},"block_order":["heading_QAUCkL"],"name":"t:sections.rich_text.presets.rich_text.name","settings":{"color_scheme":"","separate_section_with_border":false,"content_width":"md","text_position":"center","remove_vertical_spacing":false}},"image_text_lba_ELymAP":{"type":"image-text-lba","blocks":{"description_PxWdBb":{"type":"description","settings":{"image":"shopify:\/\/shop_images\/787ee7f667a8f258fcf01afa035928af7db6c96b_127be234-de9e-425c-b41a-38cfa8eaa30a.png","title_":"Jean-Marc Lemaitre","text":"<p>Ph.D. de Biologie Moléculaire et Cellulaire.<br\/>- Expert international du vieillissement cellulaire.<br\/>- 1ère équipe au monde a avoir démontré que le vieillissement cellulaire était réversible (2011).<br\/>- Directeur de recherche INSERM.<br\/>- Co-directeur de l’Institut de Médecine Régénérative de Montpellier. <\/p>"}}},"block_order":["description_PxWdBb"],"custom_css":["section {background: #fafafa;}"],"name":"Duo image + texte","settings":{"section_height":"full-height","background_color":"#ffffff","image_layout":"full","video":"shopify:\/\/files\/videos\/LBA_CD_7s-30-ANS-